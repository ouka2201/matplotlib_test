FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache curl iputils-ping

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy the rest of the application code
COPY . .

# Build the application
RUN npm run build-stage && \
    echo "=== Build Directory Structure ===" && \
    ls -R build/

# Start the Remix server
EXPOSE 3000
CMD ["npm", "run", "start"]

