{
  "name": "cndx-corp-front",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "proxy": "http://localhost:5000",
  "scripts": {
    "dev-host": "remix vite:dev --mode development --host 127.0.0.1",
    "dev": "remix vite:dev --mode development",
    "build": "remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "build-prod": "remix vite:build --mode production",
    "build-stage": "remix vite:build --mode staging",
    "start-prod": "remix-serve ./build/server/index.js --mode production",
    "start-stage": "remix-serve ./build/server/index.js --mode staging",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc",
    "develop": "run-s msw && dev",
    "msw": "msw init ./public --no-save"
  },
