FROM nginx:alpine

# デフォルトのnginx設定をコピー
# COPY nginx.conf /etc/nginx/conf.d/default.conf

# 必要なディレクトリを作成
RUN mkdir -p /usr/share/nginx/html/public
# ディレクトリの権限を設定
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]


