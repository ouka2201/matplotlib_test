# Requirements
# - VSCodeプラグイン REST Client

### シナリオ1 全項目入力
POST http://127.0.0.1:5000/api/user/mst_organization/corpration/auth_register
Content-Type: application/json

{
    "org_id": "org_id_case01",
    "user_id": "user_id_case01",
    "org_name": "org_name_case01",
    "org_type": "org_type_case01",
    "user_company_name": "user_company_name_case01",
    "user_company_code": "company_code_case01",
    "user_org_dept_name": "user_org_dept_name_case01",
    "user_org_dept_code": "dept_code_case01"
}

