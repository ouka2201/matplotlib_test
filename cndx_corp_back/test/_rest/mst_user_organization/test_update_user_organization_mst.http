# Requirements
# - VSCodeプラグイン REST Client

### シナリオ1 既存情報あり全項目更新
POST http://127.0.0.1:5000/api/user/mst_organization/corpration/auth_update
Content-Type: application/json

{
    "org_id": "BNK0009",
    "user_id": "user_id_case01",
    "org_name": "地銀カタカナ_ケース①",
    "org_type": "地銀・支店_ケース①",
    "user_company_name": "山梨中央銀行_ケース①",
    "user_company_code": "876_ケース①",
    "user_org_dept_name": "河口湖支店_ケース①",
    "user_org_dept_code": "005_ケース①"
}

