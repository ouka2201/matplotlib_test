Content-Type: application/json

{
  "corporateNumber": "1234567890123",
  "agreementCategory": "12",
  "orgId": "ASE",
  "startYear": "2024",
  "startMonth": "04",
  "endYear": "2025",
  "endMonth": "03",
  "consentRoute": "可視化アライアンス（EP・REP）",
