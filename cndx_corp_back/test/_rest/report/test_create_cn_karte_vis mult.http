### ケース1: 単拠点1件
POST http://127.0.0.1:5000/api/report/cn-karte/create/vis
Content-Type: application/json

{
  "corporate_number": "9999888877770",
  "agreement_category": "12",
  "org_id": "ASE",
  "start_year": "2024",
  "start_month": "04",
  "end_year": "2025",
  "end_month": "03",
  "consent_route": "可視化アライアンス（EP・REP）",
  "creation_format": "CNカルテ(簡易版)",
  "is_for_multibuilding": false,
  "building_ids_for_single": ["9999888877770001001"],
  "need_data_insufficiency_list": false,
  "need_report_backdata": false,
  "need_kpi_list": true
}


